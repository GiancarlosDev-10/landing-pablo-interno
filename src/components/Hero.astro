---
import ProgressBar from './ProgressBar.astro';
---

<section class="min-h-screen flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-[640px] space-y-4">
    
    <!-- Logo -->
    <div class="flex justify-center animate-fade-up" style="animation-delay: 0.2s;">
      <img 
        src="/image.png" 
        alt="Pablo Logo" 
        width="180" 
        height="180"
        class="animate-float-in"
      />
    </div>

    <!-- Label -->
    <div class="flex justify-center items-center gap-3 animate-fade-up" style="animation-delay: 0.3s;">
      <span class="text-[#4C1D95]" style="font-family: Arial; font-size: 14px; line-height: 20px; text-align: center; font-weight: 400;">
       ¡ YA DISPONIBLE !
      </span>
    </div>

    <!-- H1 -->
    <h1 class="text-center" style="font-family: Arial; font-size: 54px; font-weight: 700; line-height: 62px; text-align: center; color: #4C1D95;" class="animate-fade-up" style="animation-delay: 0.4s;">
      Pablo está <span style="background: linear-gradient(91deg, #F6B72B 0.73%, #FBAB21 57.69%, #FEA41B 99.46%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">listo</span> para ti
    </h1>

    <!-- Subtitle -->
    <p class="text-center" style="font-family: Arial; font-size: 18px; font-weight: 400; line-height: 26px; text-align: center; color: #4C1D95;" class="animate-fade-up" style="animation-delay: 0.5s;">
      Tu asistente financiero inteligente. <br /> Únete a nosotros y sé de los primeros en transformar tus finanzas.
    </p>

    <!-- Barra de progreso -->
    <ProgressBar />

    <!-- Stats row -->
    <div class="grid grid-cols-3 gap-4 animate-fade-up" style="animation-delay: 0.7s;">
      <!-- Tarjeta 1: Usuarios -->
      <div class="bg-white border border-[#E5E7EB] rounded-2xl p-4 text-center shadow-sm">
        <div class="text-center" style="font-family: Arial; font-size: 24px; font-weight: 700; line-height: 32px; text-align: center; color: #4C1D95;" id="user-count">0</div>
        <div class="text-center" style="font-family: Arial; font-size: 14px; font-weight: 400; line-height: 20px; text-align: center; color: #4C1D95; margin-top: 4px;">Usuarios</div>
      </div>

      <!-- Tarjeta 2: Porcentaje -->
      <div class="bg-white border border-[#E5E7EB] rounded-2xl p-4 text-center shadow-sm">
        <div class="text-center" style="font-family: Arial; font-size: 24px; font-weight: 700; line-height: 32px; text-align: center; color: #4C1D95;" id="percentage">0%</div>
        <div class="text-center" style="font-family: Arial; font-size: 14px; font-weight: 400; line-height: 20px; text-align: center; color: #4C1D95; margin-top: 4px;">de la meta</div>
      </div>

      <!-- Tarjeta 3: Ubicación -->
      <div class="bg-white border border-[#E5E7EB] rounded-2xl p-4 text-center shadow-sm">
        <div class="text-center" style="font-family: Arial; font-size: 24px; font-weight: 700; line-height: 32px; text-align: center; color: #4C1D95;">🇵🇪</div>
        <div class="text-center" style="font-family: Arial; font-size: 14px; font-weight: 400; line-height: 20px; text-align: center; color: #4C1D95; margin-top: 4px;">Lima, Perú</div>
      </div>
    </div>

    <!-- CTA Button -->
    <div class="flex justify-center animate-fade-up" style="animation-delay: 0.8s;">
      <a 
        href="https://www.usapablo.com/"
        class="inline-flex items-center gap-2 text-center" style="font-family: Arial; font-size: 18px; font-weight: 700; line-height: 26px; text-align: center; border-radius: 24px; background: linear-gradient(91deg, #F6B72B 0.73%, #FBAB21 57.69%, #FEA41B 99.46%); box-shadow: 1px 2px 6px 1px rgba(215, 210, 244, 0.80); color: #0c0c0c; padding: 16px 32px; hover:transform hover:-translate-y-0.5 transition-all duration-200;"
      >
        Únete a nuestra comunidad
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  // Actualizar stats con animación
  document.addEventListener('DOMContentLoaded', () => {
    // Obtener datos desde el endpoint o usar los datos del componente ProgressBar
    const updateStats = async () => {
      try {
        const response = await fetch('/api/users');
        const data = await response.json();
        
        // Animar contador de usuarios
        animateValue('user-count', 0, data.count, 1500);
        
        // Actualizar porcentaje
        const percentageElement = document.getElementById('percentage');
        if (percentageElement) {
          percentageElement.textContent = `${data.percentage.toFixed(1)}%`;
        }
      } catch (error) {
        console.error('Error updating stats:', error);
      }
    };

    updateStats();
  });

  // Función para animar números
  function animateValue(id: string, start: number, end: number, duration: number) {
    const element = document.getElementById(id);
    if (!element) return;

    const range = end - start;
    const increment = range / (duration / 16);
    let current = start;

    const timer = setInterval(() => {
      current += increment;
      if ((increment > 0 && current >= end) || (increment < 0 && current <= end)) {
        element.textContent = end.toString();
        clearInterval(timer);
      } else {
        element.textContent = Math.floor(current).toString();
      }
    }, 16);
  }
</script>
