---
import { fetchUserCount } from '../lib/sheets';
import { GOAL } from '../lib/config';
import ProgressBarClient from './ProgressBarClient.astro';

// Obtener datos del servidor (para producción y fallback)
const userCount = await fetchUserCount();
const percentage = Math.min((userCount / GOAL) * 100, 100);

const data = {
  count: userCount,
  goal: GOAL,
  percentage: percentage,
};
---

<div class="w-full max-w-2xl mx-auto animate-fade-up" style="animation-delay: 0.6s;">
  <!-- Labels sobre la barra -->
  <div class="flex justify-between items-center mb-3">
    <div class="flex items-center gap-2">
      <div class="w-2 h-2 rounded-full animate-pulse-dot" style="background: linear-gradient(91deg, #F6B72B 0.73%, #FBAB21 57.69%, #FEA41B 99.46%);"></div>
      <span class="text-[#4C1D95]" style="font-family: Arial; font-size: 14px; font-weight: 400; line-height: 20px; text-align: center;">Comunidad creciendo</span>
    </div>
    <span class="text-[#4C1D95]" style="font-family: Arial; font-size: 14px; font-weight: 400; line-height: 20px; text-align: center;">{data.count} / {data.goal} disponibles</span>
  </div>

  <!-- Barra de progreso -->
  <div class="relative h-13 bg-white rounded-full border-2 border-[#E5E7EB] overflow-hidden shadow-sm">
    <!-- Fill animado -->
    <div 
      class="absolute top-0 left-0 h-full transition-all duration-[1.6s] ease-[cubic-bezier(0.22,1,0.36,1)] rounded-full flex items-center justify-end pr-2" style="width: 0%; background: linear-gradient(91deg, #F6B72B 0.73%, #FBAB21 57.69%, #FEA41B 99.46%);"
      id="progress-fill"
    >
      <!-- Patrón de olas SVG -->
      <svg class="absolute inset-0 w-full h-full opacity-35" viewBox="0 0 100 20" preserveAspectRatio="none">
        <path 
          d="M0,10 Q25,5 50,10 T100,10 L100,20 L0,20 Z" 
          fill="white"
        />
        <path 
          d="M0,15 Q25,10 50,15 T100,15 L100,20 L0,20 Z" 
          fill="white"
          opacity="0.5"
        />
      </svg>

      <!-- Logo kawaii de Pablo -->
      <div class="relative z-10">
        <div class="w-13 h-13 bg-transparent rounded-full flex items-center justify-center animate-bobble">
          <img src="/logo.png" alt="Pablo Logo" width="56" height="56" class="rounded-full" />
        </div>
      </div>
    </div>
  </div>

  <!-- Texto de estado con contador dinámico -->
  <div class="text-center mt-3">
    <span class="text-[#4C1D95]" style="font-family: Arial; font-size: 14px; font-weight: 400; line-height: 20px; text-align: center;">
      Actualizado en tiempo real
    </span>
  </div>
</div>

<!-- Componente de isla para actualización dinámica -->
<ProgressBarClient initialData={data} client:load />

<style>
  .h-13 {
    height: 52px;
  }
  .w-13 {
    width: 52px;
  }
</style>
