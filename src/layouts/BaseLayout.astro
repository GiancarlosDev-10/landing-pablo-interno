---
import '../styles/global.css';
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Pablo - Tu asistente financiero inteligente" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- No need Google Fonts for Arial -->
  </head>
  <body class="bg-[#FAFAFA] text-[#4C1D95]" style="font-family: Arial; font-size: 18px; line-height: 26px;">
    <slot />
  </body>
</html>
